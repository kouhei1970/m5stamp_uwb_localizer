menu "UWB Probe Configuration"

    choice UWB_PROBE_BOARD
        prompt "Target host board"
        default UWB_PROBE_BOARD_STAMPS3
        help
            Select which host board's pin definitions (boards/stamps3.h,
            boards/atoms3.h, or boards/stampfly.h, at the repo root) main.c
            uses to configure uwb_port.

        config UWB_PROBE_BOARD_STAMPS3
            bool "M5StampS3A"

        config UWB_PROBE_BOARD_ATOMS3
            bool "M5 AtomS3"

        config UWB_PROBE_BOARD_STAMPFLY
            bool "StampFly (M5StampS3A on drone, rear 12P FPC)"
            help
                M5StampS3A 背面に予約されている 12P FPC (0.5mm) 経由で
                接続する構成。SPI 4線に加えて RST / IRQ / WAKEUP がすべて
                取れる (boards/stampfly.h)。電源も同じコネクタの VDD_3V3
                から取るので降圧回路は要らない。
                旧 GROVE 4線構成は廃案 (2026-08-22)。

    endchoice

    choice UWB_BOARD_ATOMS3_PINOUT
        prompt "AtomS3 pin layout"
        depends on UWB_PROBE_BOARD_ATOMS3
        default UWB_BOARD_ATOMS3_PINOUT_A
        help
            Selects which of the two AtomS3 pin layouts boards/atoms3.h
            builds (docs/IRQ_POLICY.md). Layout A repurposes the Grove port
            (G1/G2) for RST/IRQ and wires a ToF sensor to the bottom header
            (G38/G39); recommended for the plain AtomS3, whose G38/G39 are
            shared with the onboard MPU6886 IMU. Layout B instead uses the
            bottom header (G38/G39) for RST/IRQ and plugs the ToF sensor
            straight into the Grove port; recommended for AtomS3R, whose
            G38/G39 have nothing else attached.

        config UWB_BOARD_ATOMS3_PINOUT_A
            bool "Layout A: RST/IRQ=Grove(G1/G2), ToF I2C=G38/G39 (hand-wired to bottom header)"

        config UWB_BOARD_ATOMS3_PINOUT_B
            bool "Layout B: RST/IRQ=G38/G39, ToF I2C=Grove(G1/G2) (plug-and-play)"

    endchoice

    config UWB_SPI_FAST_HZ
        int "SPI fast clock override [Hz] (0 = use boards/*.h default)"
        range 0 32000000
        default 0
        help
            Overrides cfg.spi_fast_hz after it has been populated from
            boards/*.h's BOARD_*_UWB_PORT_CONFIG. The default, 0, leaves
            it untouched - i.e. exactly the boards/*.h value (currently
            16 MHz), identical to the behaviour before this option
            existed.

            Useful for bisecting a Device ID that cannot be read, or that
            reads back intermittently corrupted, by lowering the SPI
            clock. The QM33120W/DW3720 SPI clock ceiling is 32 MHz.

endmenu
