menu "UWB Devtest Configuration"

    choice UWB_DEVTEST_BOARD
        prompt "Target host board"
        default UWB_DEVTEST_BOARD_STAMPS3
        help
            Select which host board's pin definitions (boards/stamps3.h or
            boards/atoms3.h, at the repo root) main.cpp uses to configure
            uwb::Qm33120.

        config UWB_DEVTEST_BOARD_STAMPS3
            bool "M5StampS3A"

        config UWB_DEVTEST_BOARD_ATOMS3
            bool "M5 AtomS3"

    endchoice

    choice UWB_DEVTEST_ROLE
        prompt "Device role"
        default UWB_DEVTEST_ROLE_SENDER
        help
            SENDER calls Qm33120::sendFrame() once a second. RECEIVER polls
            Qm33120::receiveFrame() in a loop. Flash one board as SENDER and
            a second board as RECEIVER (same PHY config, i.e. same defaults)
            to verify over-the-air connectivity end to end.

        config UWB_DEVTEST_ROLE_SENDER
            bool "Sender (periodic sendFrame)"

        config UWB_DEVTEST_ROLE_RECEIVER
            bool "Receiver (polling receiveFrame)"

    endchoice

endmenu
