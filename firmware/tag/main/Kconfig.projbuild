menu "UWB Tag Configuration"

    choice UWB_TAG_BOARD
        prompt "ホストボード"
        default UWB_TAG_BOARD_STAMPS3
        help
            main.cpp が uwb::Qm33120 の設定に使うピン定義
            （リポジトリ直下の boards/stamps3.h / boards/atoms3.h /
            boards/stampfly.h）を選ぶ。

        config UWB_TAG_BOARD_STAMPS3
            bool "M5StampS3A"

        config UWB_TAG_BOARD_ATOMS3
            bool "M5 AtomS3"

        config UWB_TAG_BOARD_STAMPFLY
            bool "StampFly (M5StampS3A on drone, rear 12P FPC)"
            help
                M5StampS3A 背面に予約されている 12P FPC (0.5mm) 経由で
                接続する構成。SPI 4線に加えて RST / IRQ / WAKEUP がすべて
                取れる (boards/stampfly.h)。電源も同じコネクタの VDD_3V3
                から取るので降圧回路は要らない。
                旧 GROVE 4線構成は廃案 (2026-08-22)。

    endchoice

    choice UWB_BOARD_ATOMS3_PINOUT
        prompt "AtomS3 のピン構成"
        depends on UWB_TAG_BOARD_ATOMS3
        default UWB_BOARD_ATOMS3_PINOUT_A
        help
            boards/atoms3.h が生成するピン構成を2通りから選ぶ
            (docs/IRQ_POLICY.md)。構成Aは Grove ポート(G1/G2)を RST/IRQ に
            転用し、ToF は底面ヘッダ(G38/G39)へ手配線する構成で、G38/G39が
            オンボードの MPU6886 IMU と共用になる無印 AtomS3 向け。
            構成Bは底面ヘッダ(G38/G39)を RST/IRQ に使い、ToF は Grove に
            挿すだけで済む構成で、G38/G39 に何も繋がっていない AtomS3R 向け。

        config UWB_BOARD_ATOMS3_PINOUT_A
            bool "構成A: RST/IRQ=Grove(G1/G2), ToF I2C=G38/G39（底面へ手配線）"

        config UWB_BOARD_ATOMS3_PINOUT_B
            bool "構成B: RST/IRQ=G38/G39, ToF I2C=Grove(G1/G2)（Grove に挿すだけ）"

    endchoice

    choice UWB_TAG_METHOD
        prompt "測距方式"
        default UWB_TAG_METHOD_DS
        help
            SS-TWR (requestRange()): Poll/Response の1往復。距離はTag側で計算。
            DS-TWR (requestDSRange()): さらにFinal/Result往復が加わり、距離は
            Anchor側で計算されTagへ返送される。firmware/anchor 側の設定
            （firmware/anchor/main/Kconfig.projbuild）と必ず同じ方式にすること。
            既定はDS-TWR（本プロジェクトの本番運用の判断。SS-TWRよりクロック
            ドリフトの影響を受けにくい代わりに、アンカーあたり往復が1回増える）。

        config UWB_TAG_METHOD_SS
            bool "SS-TWR"

        config UWB_TAG_METHOD_DS
            bool "DS-TWR"

    endchoice

    config UWB_TAG_PER_ANCHOR_INTERVAL_MS
        int "同一周内でアンカーへの測距を始める間隔の最小値 [ms]"
        range 0 5000
        default 0
        help
            uwb::SchedulerConfig::perAnchorIntervalMs に渡す値。0なら前の
            アンカーの測距が終わり次第すぐ次へ進む（最速）。R6（更新レート）
            の実測・調整のためにあえて間隔を空けたい場合に上げる
            （docs/PLAN.md 参照）。

    config UWB_TAG_CYCLE_INTERVAL_MS
        int "1周終えてから次の周を始めるまでの間隔の最小値 [ms]"
        range 0 60000
        default 0
        help
            uwb::SchedulerConfig::cycleIntervalMs に渡す値。0なら前の周の
            ポーリングが終わり次第すぐ次の周を始める。下流の消費側の
            想定周期に合わせて意図的に更新レートを抑えたい場合に上げる。

    config UWB_TAG_STATS_INTERVAL_MS
        int "測距成功率(\"type\":\"stats\")行を出す間隔 [ms]（0で出力しない）"
        range 0 60000
        default 1000
        help
            uwb::RangingScheduler::stats() が持つ「どのアンカーが悪いか」の
            成功率統計を、毎周期の "type":"fix" 行とは別に "type":"stats"
            行としてこの間隔で出す(docs/HANDOFF.md §5 タスクE)。fix は
            毎周期（約31Hz）出るため、そこへ成功率を足すとログが太る。
            JsonLinesHal（third_party/uwb_localizer 側）は未知のtypeを
            読み捨てるので互換性は安全（本ファイル冒頭コメント参照）。

            0 にすると stats 行そのものを出さない（従来どおり fix/meas/
            anchors のみ）。

    config UWB_TAG_CONSOLE
        bool "シリアルコンソール (USB-Serial/JTAG) を有効にする"
        default y
        help
            有効にすると、起動時に ESP-IDF の console コンポーネント
            (linenoise + argtable3) による REPL を専用タスクで立ち上げ、
            USB 経由で次のコマンドを受け付ける。

                anchor list
                anchor set <idx> <hex_addr> <x> <y> <z>
                anchor delay <idx> <meters>
                anchor enable <idx> / anchor disable <idx>
                anchor count <n>
                output <on|off>   （JSON Lines 出力の一時停止）
                save / reset-config / info / reboot

            これにより「アンカー座標を数cm直すたびに再ビルド・再書き込み」が
            不要になる (docs/GETTING_STARTED.md §7)。

            コンソールは測位ループとは別タスクで動き、編集内容は次の測位周期
            の先頭で取り込まれる（実装方針は main/tag_console.hpp の冒頭
            コメントを参照）。

            無効にすると tag_console.cpp 自体がビルド対象から外れ、console
            コンポーネントへの依存も消える。NVSに保存済みのテーブルで起動する
            機能だけは残るので、「コンソールで設定して save したあと、
            コンソールを無効にしたファームを焼く」運用もできる。

    config UWB_TAG_ENABLE_EKF
        bool "毎周期 Lv3 EKF (uwb_ekf) も呼ぶ"
        default n
        help
            有効にすると、Lv0/Lv2の呼び出しと同じ単一タスクから
            uwb::PositioningPipeline::updateEkf() を毎周期呼ぶ
            （uwb_ekf はスレッド安全でないため。uwb_ranging_pipeline.hpp
            参照）。JSON LinesのfixログにLv3のセクションと計算時間
            (solve_us_lv3) が追加される。既定は無効
            （Lv0/Lv2の本番経路の検証にはEKFの状態管理までは不要なため）。

    config UWB_TAG_AUTO_2D_FALLBACK
        bool "アンカー平面が原点を通ると検出された場合、dim=2(高さ固定)へ自動フォールバックする"
        default y
        help
            docs/ANCHOR_PLACEMENT.md / docs/archive/PROGRESS.md Phase 4 に記録されている
            既知の現象: 登録済みアンカーが全て同一平面上にあり、かつその
            平面がワールド原点をほぼ通っている場合（床にアンカーを並べる
            構成で z~=0 になりがち）、Lv2 は毎周期 ok=0 を返す。
            このオプションが有効で、起動時にその条件が検出されたときは、
            main.cpp が AnchorTable::setDimension2D(UWB_TAG_FIXED_Z_MM/1000.0f)
            を呼び、x,yだけは解けるようにする（高さは固定値になり解かれない）。
            生の ok=0 失敗をそのまま見たい場合（配置を調整している最中など）は
            無効にする。

    config UWB_TAG_FIXED_Z_MM
        int "dim=2フォールバック時に固定する高さ [mm]"
        range -10000 10000
        default 1200
        depends on UWB_TAG_AUTO_2D_FALLBACK
        help
            UWB_TAG_AUTO_2D_FALLBACK が発動したときのみ使われる。
            ワールド座標系でのタグの想定運用高さを設定すること。

    choice UWB_TIMING_PROFILE
        prompt "TWR 遅延プリセット"
        default UWB_TIMING_PROFILE_POLLING_BOTH
        help
            docs/TIMING_PRESETS.md で確定した、役割(タグ/アンカー) × IRQ有無の
            組み合わせごとの遅延パラメータ一式（応答遅延・受信タイムアウト等）
            を切り替える。

            **タグとアンカーは必ず同じプリセットを選ぶこと。** 片側だけ変える
            と測距が成立しない。しかも症状は「距離が出ない」だけでどちらが
            悪いのかログからは分からないため、フレーム(Poll/Response)に
            版番号と種別を載せて相手と比較し、不一致なら警告する仕組みが
            入っている（測距自体は続行する。docs/TIMING_PRESETS.md §3）。

            この設定値は自動では変わらない。例えば BothIrq を選んでも
            タグの pin_irq が未配線で待ちがポーリングへフォールバックした
            場合、遅延の値自体は変えず、起動ログで警告するだけになる
            （docs/TIMING_PRESETS.md §4(b)）。

        config UWB_TIMING_PROFILE_POLLING_BOTH
            bool "両側ポーリング（約31Hz。現在の既定値と同一）"

        config UWB_TIMING_PROFILE_ANCHOR_IRQ
            bool "アンカーのみ IRQ（約59Hz。標準構成）"

        config UWB_TIMING_PROFILE_BOTH_IRQ
            bool "両側 IRQ（約90Hz。タグを別配線できた場合）"

    endchoice

    config UWB_ENABLE_IRQ
        bool "IRQ を起床信号として使う（未配線なら自動でポーリングへフォールバック）"
        default n
        help
            IRQ（割り込み要求）を、受信を待つループの「起床信号」としてだけ
            使う。ステータスレジスタの判読・フレーム照合・エラー処理は
            IRQ有効/無効に関わらず完全に同一のポーリング経路を通る
            （dwt_setcallbacks()/dwt_isr()は使わない。docs/IRQ_POLICY.md）。

            タグは標準構成（StampFly、GROVE 4本をSPIに使い切る）では
            IRQ 線が残らずポーリングで成立させる方針であり、単体
            M5StampS3A/AtomS3 でタグを組む場合のみ pin_irq が配線される。
            いずれの場合も実機での極性検証がまだ済んでいないため既定は
            n（無効）にしてある。

            有効にしても pin_irq が未配線（StampFly構成）、または ISR
            登録に失敗した場合は自動的にポーリングへフォールバックする
            （`uwb::Qm33120::irqActive()` で実際に有効になったかを確認
            できる。起動ログにも出る）。ポーリング経路は常に第一級の
            実装として残っており、劣化版ではない。

endmenu
