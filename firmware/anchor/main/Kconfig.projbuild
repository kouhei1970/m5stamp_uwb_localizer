menu "UWB Anchor Configuration"

    choice UWB_ANCHOR_BOARD
        prompt "Target host board"
        default UWB_ANCHOR_BOARD_ATOMS3
        help
            Select which host board's pin definitions (boards/stamps3.h or
            boards/atoms3.h, at the repo root) main.cpp uses to configure
            uwb::Qm33120.

        config UWB_ANCHOR_BOARD_STAMPS3
            bool "M5Stamp S3"

        config UWB_ANCHOR_BOARD_ATOMS3
            bool "M5 AtomS3"

    endchoice

    choice UWB_ANCHOR_METHOD
        prompt "Ranging method"
        default UWB_ANCHOR_METHOD_DS
        help
            DS-TWR (double-sided, respondDSRange()): adds a Final exchange
            and a Result frame; distance is computed on this ANCHOR side and
            relayed back to the TAG. 本プロジェクトの本番運用では DS-TWR を
            優先する方針のため、既定値は DS-TWR とする。
            SS-TWR (single-sided, respondRange()): one Poll/Response
            exchange, distance is computed on the TAG side instead. TAG側も
            同じ方式を選ぶ必要がある。

        config UWB_ANCHOR_METHOD_DS
            bool "DS-TWR (default, production)"

        config UWB_ANCHOR_METHOD_SS
            bool "SS-TWR"

    endchoice

    config UWB_ANCHOR_SHORT_ADDR
        hex "自分のショートアドレスの初期値 (NVSが空のときに使う値)"
        range 0x0000 0xFFFE
        default 0x0002
        help
            このアンカー自身のTWRショートアドレスの **初期値**。

            起動時はまず NVS (components/uwb_cfgstore) を読み、保存された値が
            あればそちらを使う。NVSが空・未初期化・破損のいずれの場合も
            この値へフォールバックする。したがって何も設定しなければ
            従来どおりこの値でそのまま動く。

            実機5台に別々のアドレスを入れる作業は、ビルドをやり直すのではなく
            シリアルコンソール (UWB_ANCHOR_CONSOLE) から

                addr set 0x0003
                save

            で行うことを推奨する (docs/GETTING_STARTED.md §6)。
            0xFFFF はブロードキャストアドレスなので使わないこと。

    config UWB_ANCHOR_CONSOLE
        bool "シリアルコンソール (USB-Serial/JTAG) を有効にする"
        default y
        help
            有効にすると、起動時に ESP-IDF の console コンポーネント
            (linenoise + argtable3) による REPL を専用タスクで立ち上げ、
            USB 経由で次のコマンドを受け付ける。

                addr / addr set <hex> / save / reset-config / info / reboot

            測距ループとは別タスクで動き、ショートアドレスの変更は
            次の応答から反映される。

            無効にすると anchor_console.cpp 自体がビルド対象から外れ、
            console コンポーネントへの依存も消える。NVSに保存済みの
            アドレスで起動する機能だけは残るので、「コンソールで設定して
            save したあと、コンソールを無効にしたファームを焼く」運用も
            できる。

endmenu
